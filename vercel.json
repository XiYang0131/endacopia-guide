{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/assets/steam-authorized/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/steam-media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/endacopia-header-20260730.jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/endacopia-prologue-walkthrough/",
      "destination": "https://www.endacopiaguide.com/endacopia-beginner-guide/",
      "permanent": true
    },
    {
      "source": "/endacopia-secret-ending/",
      "destination": "https://www.endacopiaguide.com/endacopia-ending-c-complete-route/",
      "permanent": true
    },
    {
      "source": "/endacopia-stay-achievement/",
      "destination": "https://www.endacopiaguide.com/endacopia-ending-c-complete-route/",
      "permanent": true
    }
  ]
}
